{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reliquary Installer",
  "version": "0.1.0",
  "identifier": "gg.reliquary.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Install Reliquary",
        "width": 560,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#07080C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
